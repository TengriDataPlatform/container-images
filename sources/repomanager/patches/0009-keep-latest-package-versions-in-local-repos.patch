+<?php
+
+namespace Controllers\Repo\Package;
+
+use Controllers\Process;
+
+/**
+ *  Select the packages to carry over to a new local repository snapshot,
+ *  keeping only the X latest versions of each package.
+ *
+ *  Packages are grouped by name and architecture. Name, version and
+ *  architecture are first parsed from the standard file name
+ *  (name_version_arch.deb, name-version-release.arch.rpm). When the file name
+ *  does not follow this scheme, they are read from the package headers. When
+ *  both fail, the package is kept as-is and reported as unparsed.
+ *
+ *  Versions are compared with PHP ports of dpkg's verrevcmp() and rpm's
+ *  rpmvercmp(). The epoch is ignored on purpose: it is not part of standard
+ *  file names, so ignoring it keeps both sources comparable.
+ */
+class KeepLatest
+{
+    private $packageType;
+    private $keepLatest;
+    private $kept = [];
+    private $skipped = [];
+    private $unparsed = [];
+    private $headerParsed = [];
+
+    public function __construct(string $packageType, int $keepLatest)
+    {
+        $this->packageType = $packageType;
+        $this->keepLatest = $keepLatest;
+    }
+
+    /**
+     *  Split the specified package paths into kept and skipped ones.
+     *  Files that are not packages of the repository type (e.g. deb sources)
+     *  are always kept. The original order of the kept paths is preserved.
+     */
+    public function filter(array $paths): void
+    {
+        $groups = [];
+        $skipped = [];
+
+        $this->kept = [];
+        $this->skipped = [];
+        $this->unparsed = [];
+        $this->headerParsed = [];
+
+        foreach ($paths as $path) {
+            if (!preg_match('/\.' . $this->packageType . '$/', $path)) {
+                continue;
+            }
+
+            $package = $this->parseFilename(basename($path));
+
+            if ($package === null) {
+                $package = $this->parseHeaders($path);
+
+                if ($package === null) {
+                    $this->unparsed[] = $path;
+                    continue;
+                }
+
+                $this->headerParsed[] = $path;
+            }
+
+            $package['path'] = $path;
+            $groups[$package['name'] . '|' . $package['arch']][] = $package;
+        }
+
+        foreach ($groups as $group) {
+            // Sort from the newest to the oldest version, then by file name so
+            // the result does not depend on the directory listing order
+            usort($group, function ($a, $b) {
+                $result = $this->compareVersions($b['version'], $a['version']);
+
+                if ($result != 0) {
+                    return $result;
+                }
+
+                return strcmp(basename($a['path']), basename($b['path']));
+            });
+
+            // Count distinct versions: several files carrying the same version
+            // are all kept or all skipped together
+            $versions = 0;
+            $previousVersion = null;
+
+            foreach ($group as $package) {
+                if ($previousVersion === null or $this->compareVersions($package['version'], $previousVersion) != 0) {
+                    $versions++;
+                    $previousVersion = $package['version'];
+                }
+
+                if ($versions > $this->keepLatest) {
+                    $skipped[$package['path']] = true;
+                }
+            }
+        }
+
+        foreach ($paths as $path) {
+            if (isset($skipped[$path])) {
+                $this->skipped[] = $path;
+            } else {
+                $this->kept[] = $path;
+            }
+        }
+    }
+
+    /**
+     *  Return the paths to carry over to the new snapshot
+     */
+    public function getKept(): array
+    {
+        return $this->kept;
+    }
+
+    /**
+     *  Return the paths of the old versions that are not carried over
+     */
+    public function getSkipped(): array
+    {
+        return $this->skipped;
+    }
+
+    /**
+     *  Return the paths of the packages whose name, version or architecture
+     *  could be determined neither from the file name nor from the headers
+     */
+    public function getUnparsed(): array
+    {
+        return $this->unparsed;
+    }
+
+    /**
+     *  Return the paths of the packages whose name, version and architecture
+     *  were read from the headers because of a non-standard file name
+     */
+    public function getHeaderParsed(): array
+    {
+        return $this->headerParsed;
+    }
+
+    /**
+     *  Compare two versions of the repository package type.
+     *  Return a negative number, 0 or a positive number.
+     */
+    private function compareVersions(string $a, string $b): int
+    {
+        if ($this->packageType == 'deb') {
+            return self::compareDebVersions($a, $b);
+        }
+
+        return self::compareRpmVersions($a, $b);
+    }
+
+    /**
+     *  Parse name, version and architecture from a standard package file name.
+     *  Return null when the file name does not follow the standard scheme.
+     */
+    private function parseFilename(string $filename): ?array
+    {
+        if ($this->packageType == 'deb') {
+            if (!preg_match('/^([a-z0-9][a-z0-9+.-]*)_([A-Za-z0-9.+~-]+)_([a-z0-9-]+)\.deb$/', $filename, $matches)) {
+                return null;
+            }
+
+            return ['name' => $matches[1], 'version' => $matches[2], 'arch' => $matches[3]];
+        }
+
+        if (!preg_match('/^(.+)-([^-]+)-([^-]+)\.([A-Za-z0-9_]+)\.rpm$/', $filename, $matches)) {
+            return null;
+        }
+
+        return ['name' => $matches[1], 'version' => $matches[2] . '-' . $matches[3], 'arch' => $matches[4]];
+    }
+
+    /**
+     *  Read name, version and architecture from the package headers.
+     *  Return null when the headers cannot be read.
+     */
+    private function parseHeaders(string $path): ?array
+    {
+        if ($this->packageType == 'deb') {
+            $command = '/usr/bin/dpkg-deb --show --showformat=' . escapeshellarg('${Package} ${Version} ${Architecture}\n');
+            $pattern = '/^(\S+) (\S+) (\S+)$/';
+        } else {
+            $command = '/usr/bin/rpm -qp --nosignature --nodigest --queryformat=' . escapeshellarg('%{NAME} %{VERSION} %{RELEASE} %{ARCH} %{SOURCERPM}\n');
+            $pattern = '/^(\S+) (\S+) (\S+) (\S+) (\S+)$/';
+        }
+
+        $myprocess = new Process($command . ' ' . escapeshellarg($path) . ' 2>/dev/null');
+        $myprocess->execute();
+        $output = trim($myprocess->getOutput());
+        $myprocess->close();
+
+        if ($myprocess->getExitCode() != 0 or !preg_match($pattern, $output, $matches)) {
+            return null;
+        }
+
+        if ($this->packageType == 'deb') {
+            // Drop the epoch to stay comparable with versions parsed from file names
+            return ['name' => $matches[1], 'version' => preg_replace('/^[0-9]+:/', '', $matches[2]), 'arch' => $matches[3]];
+        }
+
+        // Source packages have no SOURCERPM and are grouped under the 'src' architecture
+        // like their file names (*.src.rpm) are
+        $arch = $matches[5] == '(none)' ? 'src' : $matches[4];
+
+        return ['name' => $matches[1], 'version' => $matches[2] . '-' . $matches[3], 'arch' => $arch];
+    }
+
+    /**
+     *  Compare two Debian versions ([epoch:]upstream[-revision]) like dpkg does,
+     *  ignoring the epoch. Return a negative number, 0 or a positive number.
+     */
+    public static function compareDebVersions(string $a, string $b): int
+    {
+        $a = preg_replace('/^[0-9]+:/', '', $a);
+        $b = preg_replace('/^[0-9]+:/', '', $b);
+
+        [$upstreamA, $revisionA] = self::splitDebRevision($a);
+        [$upstreamB, $revisionB] = self::splitDebRevision($b);
+
+        $result = self::debVerRevCmp($upstreamA, $upstreamB);
+
+        if ($result != 0) {
+            return $result;
+        }
+
+        return self::debVerRevCmp($revisionA, $revisionB);
+    }
+
+    /**
+     *  Split a Debian version into upstream version and revision
+     */
+    private static function splitDebRevision(string $version): array
+    {
+        $position = strrpos($version, '-');
+
+        if ($position === false) {
+            return [$version, ''];
+        }
+
+        return [substr($version, 0, $position), substr($version, $position + 1)];
+    }
+
+    /**
+     *  Weight of a character in dpkg's version ordering: '~' sorts before
+     *  everything (even the end of the string), then letters, then other characters
+     */
+    private static function debOrder(string $char): int
+    {
+        if ($char === '' or ctype_digit($char)) {
+            return 0;
+        }
+
+        if (ctype_alpha($char)) {
+            return ord($char);
+        }
+
+        if ($char == '~') {
+            return -1;
+        }
+
+        return ord($char) + 256;
+    }
+
+    /**
+     *  Port of dpkg's verrevcmp()
+     */
+    private static function debVerRevCmp(string $a, string $b): int
+    {
+        $lengthA = strlen($a);
+        $lengthB = strlen($b);
+        $i = 0;
+        $j = 0;
+
+        while ($i < $lengthA or $j < $lengthB) {
+            $firstDiff = 0;
+
+            while (($i < $lengthA and !ctype_digit($a[$i])) or ($j < $lengthB and !ctype_digit($b[$j]))) {
+                $orderA = self::debOrder($i < $lengthA ? $a[$i] : '');
+                $orderB = self::debOrder($j < $lengthB ? $b[$j] : '');
+
+                if ($orderA != $orderB) {
+                    return $orderA - $orderB;
+                }
+
+                $i++;
+                $j++;
+            }
+
+            while ($i < $lengthA and $a[$i] == '0') {
+                $i++;
+            }
+
+            while ($j < $lengthB and $b[$j] == '0') {
+                $j++;
+            }
+
+            while ($i < $lengthA and $j < $lengthB and ctype_digit($a[$i]) and ctype_digit($b[$j])) {
+                if ($firstDiff == 0) {
+                    $firstDiff = ord($a[$i]) - ord($b[$j]);
+                }
+
+                $i++;
+                $j++;
+            }
+
+            if ($i < $lengthA and ctype_digit($a[$i])) {
+                return 1;
+            }
+
+            if ($j < $lengthB and ctype_digit($b[$j])) {
+                return -1;
+            }
+
+            if ($firstDiff != 0) {
+                return $firstDiff;
+            }
+        }
+
+        return 0;
+    }
+
+    /**
+     *  Compare two RPM version-release strings like rpm does, ignoring the
+     *  epoch. Return a negative number, 0 or a positive number.
+     */
+    public static function compareRpmVersions(string $a, string $b): int
+    {
+        $a = preg_replace('/^[0-9]+:/', '', $a);
+        $b = preg_replace('/^[0-9]+:/', '', $b);
+
+        [$versionA, $releaseA] = self::splitDebRevision($a);
+        [$versionB, $releaseB] = self::splitDebRevision($b);
+
+        $result = self::rpmVerCmp($versionA, $versionB);
+
+        if ($result != 0) {
+            return $result;
+        }
+
+        return self::rpmVerCmp($releaseA, $releaseB);
+    }
+
+    /**
+     *  Port of rpm's rpmvercmp()
+     */
+    private static function rpmVerCmp(string $a, string $b): int
+    {
+        if ($a === $b) {
+            return 0;
+        }
+
+        $lengthA = strlen($a);
+        $lengthB = strlen($b);
+        $i = 0;
+        $j = 0;
+
+        while ($i < $lengthA or $j < $lengthB) {
+            while ($i < $lengthA and !ctype_alnum($a[$i]) and $a[$i] != '~' and $a[$i] != '^') {
+                $i++;
+            }
+
+            while ($j < $lengthB and !ctype_alnum($b[$j]) and $b[$j] != '~' and $b[$j] != '^') {
+                $j++;
+            }
+
+            // Tilde sorts before everything else
+            $tildeA = ($i < $lengthA and $a[$i] == '~');
+            $tildeB = ($j < $lengthB and $b[$j] == '~');
+
+            if ($tildeA or $tildeB) {
+                if (!$tildeA) {
+                    return 1;
+                }
+
+                if (!$tildeB) {
+                    return -1;
+                }
+
+                $i++;
+                $j++;
+                continue;
+            }
+
+            // Caret sorts after the end of the string but before anything else
+            $caretA = ($i < $lengthA and $a[$i] == '^');
+            $caretB = ($j < $lengthB and $b[$j] == '^');
+
+            if ($caretA or $caretB) {
+                if ($i >= $lengthA) {
+                    return -1;
+                }
+
+                if ($j >= $lengthB) {
+                    return 1;
+                }
+
+                if (!$caretA) {
+                    return 1;
+                }
+
+                if (!$caretB) {
+                    return -1;
+                }
+
+                $i++;
+                $j++;
+                continue;
+            }
+
+            if ($i >= $lengthA or $j >= $lengthB) {
+                break;
+            }
+
+            $startA = $i;
+            $startB = $j;
+            $isNumeric = ctype_digit($a[$i]);
+
+            if ($isNumeric) {
+                while ($i < $lengthA and ctype_digit($a[$i])) {
+                    $i++;
+                }
+
+                while ($j < $lengthB and ctype_digit($b[$j])) {
+                    $j++;
+                }
+            } else {
+                while ($i < $lengthA and ctype_alpha($a[$i])) {
+                    $i++;
+                }
+
+                while ($j < $lengthB and ctype_alpha($b[$j])) {
+                    $j++;
+                }
+            }
+
+            $segmentA = substr($a, $startA, $i - $startA);
+            $segmentB = substr($b, $startB, $j - $startB);
+
+            // Numeric segments are always newer than alpha segments
+            if ($segmentB === '') {
+                return $isNumeric ? 1 : -1;
+            }
+
+            if ($isNumeric) {
+                $segmentA = ltrim($segmentA, '0');
+                $segmentB = ltrim($segmentB, '0');
+
+                if (strlen($segmentA) != strlen($segmentB)) {
+                    return strlen($segmentA) > strlen($segmentB) ? 1 : -1;
+                }
+            }
+
+            $result = strcmp($segmentA, $segmentB);
+
+            if ($result != 0) {
+                return $result > 0 ? 1 : -1;
+            }
+        }
+
+        if ($i >= $lengthA and $j >= $lengthB) {
+            return 0;
+        }
+
+        return $i >= $lengthA ? -1 : 1;
+    }
+}
