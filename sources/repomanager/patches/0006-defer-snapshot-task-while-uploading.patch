+    /**
+     *  Return the advisory lock file path for a repository.
+     *  The lock lives outside the rpm/deb trees so it never ends up inside a
+     *  snapshot directory.
+     */
+    private static function repoLockPath(int $repoId) : string
+    {
+        $lockDir = REPOS_DIR . '/.locks';
+
+        // Create the lock directory if it does not exist yet
+        if (!is_dir($lockDir)) {
+            // Suppress errors: a concurrent process may create it at the same time
+            @mkdir($lockDir, 0770, true);
+        }
+
+        return $lockDir . '/repo-' . $repoId . '.lock';
+    }
+
+    /**
+     *  Acquire a shared (read) advisory lock on a repository.
+     *  Several uploads to the same repository can hold the shared lock at the
+     *  same time. A background snapshot task waiting on the exclusive lock will
+     *  block until every shared lock has been released.
+     *
+     *  The returned handle must be kept open for the whole duration of the
+     *  operation and released with unlockRepo(). If the process dies or the
+     *  service is restarted, the kernel releases the lock automatically, so
+     *  nothing stays stuck.
+     *
+     *  @return resource|null The open file handle, or null when locking is not
+     *                        possible (best-effort, never blocks the caller).
+     */
+    public static function lockRepoShared(int $repoId)
+    {
+        $handle = @fopen(self::repoLockPath($repoId), 'c');
+
+        // If the lock file cannot be opened, do not block the upload: return
+        // null and let the caller proceed without a lock (best-effort).
+        if ($handle === false) {
+            return null;
+        }
+
+        if (!flock($handle, LOCK_SH)) {
+            fclose($handle);
+            return null;
+        }
+
+        return $handle;
+    }
+
+    /**
+     *  Release a lock previously acquired with lockRepoShared().
+     *  @param resource|null $handle
+     */
+    public static function unlockRepo($handle) : void
+    {
+        if (!is_resource($handle)) {
+            return;
+        }
+
+        flock($handle, LOCK_UN);
+        fclose($handle);
+    }
+
+    /**
+     *  Wait until there is no active upload on the repository.
+     *  Takes the exclusive advisory lock, which blocks until every shared lock
+     *  held by ongoing uploads has been released, then releases it immediately:
+     *  we only need the barrier, not to keep holding it.
+     *
+     *  This is meant to be called by background tasks only, never from a web
+     *  request: a task can afford to wait, and no HTTP client times out here.
+     *
+     *  @param callable|null $onWait Optional callback invoked once, right before
+     *                               blocking, so the caller can log that it is
+     *                               waiting for uploads to finish.
+     */
+    public static function waitRepoIdle(int $repoId, callable $onWait = null) : void
+    {
+        $handle = @fopen(self::repoLockPath($repoId), 'c');
+
+        // If the lock file cannot be opened, there is nothing to wait for.
+        if ($handle === false) {
+            return;
+        }
+
+        // Non-blocking attempt first: if it succeeds, no upload is in progress
+        // and we can return without logging a spurious "waiting" message.
+        if (!flock($handle, LOCK_EX | LOCK_NB)) {
+            if (is_callable($onWait)) {
+                $onWait();
+            }
+
+            // Blocking wait until all shared locks (uploads) are released
+            flock($handle, LOCK_EX);
+        }
+
+        // Release immediately: the barrier has been crossed
+        flock($handle, LOCK_UN);
+        fclose($handle);
+    }
